############################################################################
# net/bt/services/Make.defs
#
# SPDX-License-Identifier: Apache-2.0
#
############################################################################

ifeq ($(CONFIG_BT),y)

ifeq ($(CONFIG_BT_ANS),y)
BT_CSRCS += bt/services/ans.c
endif
ifeq ($(CONFIG_BT_DIS),y)
BT_CSRCS += bt/services/dis.c
endif
ifeq ($(CONFIG_BT_GAP_SVC),y)
BT_CSRCS += bt/services/gap_svc.c
endif
ifeq ($(CONFIG_BT_CTS),y)
BT_CSRCS += bt/services/cts.c
endif
ifeq ($(CONFIG_BT_ETS),y)
BT_CSRCS += bt/services/ets.c
endif
ifeq ($(CONFIG_BT_HRS),y)
BT_CSRCS += bt/services/hrs.c
endif
ifeq ($(CONFIG_BT_TPS),y)
BT_CSRCS += bt/services/tps.c
endif

ifeq ($(CONFIG_BT_BAS),y)
BT_CSRCS += bt/services/bas/bas.c
endif
ifeq ($(CONFIG_BT_BAS_BLS),y)
BT_CSRCS += bt/services/bas/bas_bls.c
endif
ifeq ($(CONFIG_BT_BAS_BCS),y)
BT_CSRCS += bt/services/bas/bas_bcs.c
endif

ifeq ($(CONFIG_BT_IAS),y)
BT_CSRCS += bt/services/ias/ias.c
endif
ifeq ($(CONFIG_BT_IAS_CLIENT),y)
BT_CSRCS += bt/services/ias/ias_client.c
endif
ifeq ($(CONFIG_BT_SHELL),y)
ifeq ($(CONFIG_BT_IAS),y)
BT_CSRCS += bt/services/ias/shell/ias.c
endif
ifeq ($(CONFIG_BT_IAS_CLIENT),y)
BT_CSRCS += bt/services/ias/shell/ias_client.c
endif
endif

ifeq ($(CONFIG_BT_ZEPHYR_NUS),y)
BT_CSRCS += bt/services/nus/nus.c bt/services/nus/nus_inst.c
ifeq ($(CONFIG_BT_ZEPHYR_NUS_AUTO_START_BLUETOOTH),y)
BT_CSRCS += bt/services/nus/bt_nus_auto_start_bt.c
endif
endif

ifeq ($(CONFIG_BT_OTS),y)
BT_CSRCS += bt/services/ots/ots.c bt/services/ots/ots_l2cap.c
BT_CSRCS += bt/services/ots/ots_obj_manager.c bt/services/ots/ots_oacp.c
BT_CSRCS += bt/services/ots/ots_olcp.c
ifeq ($(CONFIG_BT_OTS_DIR_LIST_OBJ),y)
BT_CSRCS += bt/services/ots/ots_dir_list.c
endif
endif

ifeq ($(CONFIG_BT_OTS_CLIENT),y)
BT_CSRCS += bt/services/ots/ots_client.c
ifneq ($(CONFIG_BT_OTS),y)
BT_CSRCS += bt/services/ots/ots_l2cap.c
endif
endif

VPATH += bt/services bt/services/bas bt/services/ias bt/services/ias/shell
VPATH += bt/services/nus bt/services/ots
DEPPATH += --dep-path bt/services --dep-path bt/services/bas
DEPPATH += --dep-path bt/services/ias --dep-path bt/services/ias/shell
DEPPATH += --dep-path bt/services/nus --dep-path bt/services/ots

CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/services
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/services/bas
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/services/ias
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/services/nus
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/services/ots

endif
