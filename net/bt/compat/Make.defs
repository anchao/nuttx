ifeq ($(CONFIG_BT),y)

# Kernel compat layer
BT_CSRCS += queue.c thread.c timeout.c mem_slab.c init.c device.c
BT_CSRCS += atomic_c.c

# Support modules
BT_CSRCS += assert.c defines.c fs.c flash.c

# HCI driver
BT_CSRCS += hci_driver.c

VPATH += bt/compat/src/kernel
VPATH += bt/compat/src/lib/os
VPATH += bt/compat/src/sections
VPATH += bt/compat/src/subsys/fs
VPATH += bt/compat/src/subsys/flash
VPATH += bt/compat/src/drivers/bluetooth/hci

DEPPATH += --dep-path bt/compat/src/kernel
DEPPATH += --dep-path bt/compat/src/lib/os
DEPPATH += --dep-path bt/compat/src/sections
DEPPATH += --dep-path bt/compat/src/subsys/fs
DEPPATH += --dep-path bt/compat/src/subsys/flash
DEPPATH += --dep-path bt/compat/src/drivers/bluetooth/hci

# Compat include paths (Zephyr convention includes without zephyr/ prefix)
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/compat/include
CFLAGS += ${INCDIR_PREFIX}$(TOPDIR)/net/bt/compat/include/zephyr

endif
